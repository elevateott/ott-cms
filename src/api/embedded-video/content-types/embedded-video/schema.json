{
  "kind": "collectionType",
  "collectionName": "embedded_videos",
  "info": {
    "singularName": "embedded-video",
    "pluralName": "embedded-videos",
    "displayName": "Video - Embedded",
    "description": "this is for embedded videos."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    },
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "attributes": {
    "Title": {
      "type": "string",
      "maxLength": 255,
      "minLength": 3,
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "shortDescription": {
      "type": "string",
      "maxLength": 500
    },
    "hlsUrl": {
      "type": "string"
    },
    "trailerUrl": {
      "type": "string"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false
    },
    "featuredCategoryThumbnail": {
      "type": "media",
      "multiple": false
    },
    "featuredCategoryVideo": {
      "type": "media",
      "multiple": false
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "uploadedOn": {
      "type": "datetime"
    },
    "duration": {
      "type": "integer"
    }
  }
}