{
  "kind": "collectionType",
  "collectionName": "embedded_videos",
  "info": {
    "singularName": "embedded-video",
    "pluralName": "embedded-videos",
    "displayName": "Video - Embedded",
    "description": "this is for embedded videos."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    },
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255,
      "minLength": 3
    },
    "url": {
      "type": "string",
      "maxLength": 255,
      "minLength": 3,
      "unique": true,
      "required": true,
      "regex": "https?:\\/\\/[a-zA-Z0-9.-]+(\\.[a-zA-Z]{2,})?(:[0-9]+)?(\\/[a-zA-Z0-9\\/_.:,?&=@%+\\-~#;!$'\\[\\]\\(\\)]+)?\\.m3u8"
    },
    "aspectRatio": {
      "type": "enumeration",
      "enum": [
        "ratio_16_9",
        "ratio_4_3",
        "ratio_1_1",
        "ratio_9_16",
        "ratio_21_9",
        "custom"
      ],
      "default": "ratio_16_9"
    },
    "quality": {
      "type": "enumeration",
      "enum": [
        "quality_auto",
        "quality_1080p",
        "quality_720p",
        "quality_480p",
        "quality_360p",
        "quality_240p",
        "quality_144p"
      ],
      "default": "quality_auto"
    },
    "embedProvider": {
      "type": "enumeration",
      "enum": [
        "Brightcove",
        "Bunny",
        "Castr",
        "Cincopa",
        "Cloudflare",
        "Dacast",
        "Hippo Video",
        "IBM Video Streaming",
        "JWPlayer",
        "Kaltura",
        "Panopto",
        "Restream",
        "StreamShark",
        "StreamYard",
        "Vidyard",
        "Vimeo",
        "Wistia",
        "Wowza",
        "Other"
      ]
    },
    "playerOptions": {
      "type": "json"
    }
  }
}