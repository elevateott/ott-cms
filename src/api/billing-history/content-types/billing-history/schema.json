{
  "kind": "collectionType",
  "collectionName": "billing_histories",
  "info": {
    "singularName": "billing-history",
    "pluralName": "billing-histories",
    "displayName": "Billing History",
    "description": "Records transactions for users and their subscription plans."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "attributes": {
    "Amount": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "description": "Transaction amount."
    },
    "Date": {
      "type": "datetime",
      "required": true,
      "description": "Date and time of the transaction."
    },
    "Status": {
      "type": "enumeration",
      "enum": [
        "Paid",
        "Failed",
        "Refunded"
      ],
      "required": true,
      "default": "Paid",
      "description": "Transaction status."
    },
    "User": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true,
      "description": "The user who made the payment."
    },
    "SubscriptionPlan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subscription.subscription",
      "required": true,
      "description": "The subscription plan associated with this transaction."
    }
  }
}